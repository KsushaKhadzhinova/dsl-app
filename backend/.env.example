# Скопируй в .env и заполни. .env никогда не коммитится (см. .gitignore).

# --- База данных ---
DATABASE_URL=postgresql+psycopg2://diagramcode:diagramcode@localhost:5432/diagramcode

# --- Redis (очередь задач + кэш) ---
REDIS_URL=redis://localhost:6379/0

# --- Аутентификация ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI-провайдер ---
# Пусто = используется заглушка (StubAIProvider), см. docs/architecture/01-ai-provider-setup.md
AI_PROVIDER=stub
AI_API_KEY=
AI_DAILY_QUOTA=20

# --- Внешние интеграции (пусто = функция недоступна, не падает) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
