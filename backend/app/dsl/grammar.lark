// Грамматика DSL DiagramCode — волна 1 (см. docs/architecture/00-system-architecture.md, §5).
// Формально описывает узлы, рёбра (в т.ч. цепочки и подписанные условием) и заголовок диаграммы.
// Пример:
//   diagram erd "Заказы" {
//     entity customer "Клиент" pk=id
//     entity order "Заказ" pk=id
//     customer -> order
//   }

start: "diagram" NOTATION STRING "{" statement* "}"

?statement: node_decl
          | edge_stmt

node_decl: IDENTIFIER IDENTIFIER STRING attr*
attr: IDENTIFIER "=" (STRING | IDENTIFIER)

edge_stmt: IDENTIFIER (edge_hop)+
edge_hop: ARROW IDENTIFIER
        | COND_ARROW IDENTIFIER

ARROW: "->"
COND_ARROW: /-\[\s*"[^"]*"\s*\]->/

// NOTATION допускает точки (erd.crows_foot.logical) и встречается только сразу
// после ключевого слова "diagram" — контекст однозначен, конфликта с IDENTIFIER нет.
NOTATION: IDENTIFIER ("." IDENTIFIER)*

%import common.CNAME -> IDENTIFIER
%import common.ESCAPED_STRING -> STRING
%import common.WS
%ignore WS
COMMENT: "//" /[^\n]*/
%ignore COMMENT
